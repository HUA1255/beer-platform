# 复制到 /usr/local/etc/home-service.env，chmod 600，属主为运行服务的用户
# Beer 调用时带的访问密钥（Authorization: Bearer <key>）
HOME_ACCESS_KEY=change-me
# 本地暂存目录（原件只在任务进行中短暂落在这里；NAS 上的 WebDAV 才是主副本）
HOME_ORIGINALS_DIR=/Users/you/home-service/originals
# 状态库（SQLite）
HOME_DB_PATH=/Users/you/home-service/data/home.sqlite3
# Windows 上 BeeBox 的基址：只写 http://<IP>:<端口>，不带路径（请求都以 /v1 开头）
# 线上实例 17494；端到端预演用开发实例 17495
HOME_BEEBOX_BASE_URL=http://192.168.x.y:17494
# 与 Windows 上的 BEEBOX_API_TOKEN 一致
HOME_BEEBOX_TOKEN=change-me
# 跟进转写任务的轮询间隔（秒）
HOME_POLL_INTERVAL=5
# 定时读 BeeBox /v1/health 的间隔（秒），B 站登录失效时发提醒邮件；0 关闭
HOME_BEEBOX_HEALTH_INTERVAL=1800
# opencode go：按类型摘要走 OpenAI 兼容接口
# 套餐条款是否允许在 Mac mini 脚本里调用仍未核实，部署前先确认 https://opencode.ai/docs/go/
HOME_OPENCODE_BASE=https://opencode.ai
# opencode go 的 API key（留空：摘要一步直接通过，不调模型）
HOME_OPENCODE_API_KEY=
# 摘要模型（默认 deepseek-v4.1-flash）
HOME_SUMMARY_MODEL=deepseek-v4.1-flash
# 通知邮件（QQ / 163 的 SMTP）；留空则跳过发信，摘要照常
# QQ: smtp.qq.com:465 ssl；163: smtp.163.com:465 ssl
HOME_SMTP_HOST=
HOME_SMTP_PORT=465
# ssl | starttls | none
HOME_SMTP_SECURITY=ssl
# 登录邮箱（也是 From；必须和登录邮箱一致）
HOME_SMTP_USER=
# 授权码，不是登录密码
HOME_SMTP_PASSWORD=
# 收件地址
HOME_MAIL_TO=

# 录音原件主副本：NAS 的 WebDAV（不用 SMB 挂载；2026-11-07 实测 SMB 会在 macOS 上僵死）
# URL 要带上个人空间路径。极空间：5005 明文 / 5006 加密
HOME_WEBDAV_URL=http://192.168.1.10:5005/your-space
HOME_WEBDAV_USER=change-me
HOME_WEBDAV_PASSWORD=change-me
# 原件在 WebDAV 根下的子目录
HOME_WEBDAV_ROOT=录音原件
