{
  "name": "beer-workbench",
  "version": "0.1.22",
  "description": "Beer：录音、素材、选题、文章、发布都在一个 DSH Desktop 工作台里完成，内容落在本机 Obsidian 库",
  "type": "module",
  "license": "MIT",
  "private": true,
  "author": "Feng",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/beer-client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "src",
    "client",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-alpha.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-desktop-workbenches",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "check": "node --check src/index.js && node --check client/beer-client.js && npm test",
    "pack:tgz": "node \"/Applications/DSH Desktop.app/Contents/Resources/app.asar.unpacked/node_modules/pnpm/bin/pnpm.cjs\" pack",
    "pack:check": "npm pack --dry-run",
    "build:editor": "esbuild editor/live-editor.js --bundle --format=esm --minify --legal-comments=eof --target=chrome110 --outfile=client/editor.js",
    "demo": "node demo/server.js"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.6-alpha.1 <4.0.0-0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@deepseek-ai/schemastery": "3.18.6-alpha.1",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "esbuild": "^0.28.2"
  }
}
